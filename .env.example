# Ellensúly local configuration
# Copy to .env if you need to override defaults. Do not commit secrets.

# Direct runs bind loopback. Compose overrides HOST to 0.0.0.0 inside the
# API container and publishes the host port on 127.0.0.1 only.
HOST=127.0.0.1
PORT=8000
# Required by Compose, because the API process inside the container is not on
# loopback. The web and ledger proxies add it. Replace this placeholder.
API_TOKEN=replace-with-a-long-random-string
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:8080

# MongoDB — the only persistence backend in v1
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=ellensuly

# Seed the supplier-continuity demonstration graph on first API start
SEED_ON_START=true
