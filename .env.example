# Ellensúly local configuration
# Copy to .env if you need to override defaults. Do not commit secrets.

HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:8080

# MongoDB — the only persistence backend in v1
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=ellensuly

# Seed the supplier-continuity demonstration graph on first API start
SEED_ON_START=true
